# ============================================
# Django 환경 변수 설정 파일 (템플릿)
# ============================================
# 
# 사용 방법:
# 1. 이 파일을 .env로 복사: cp .env.example .env
# 2. 각 환경 변수의 값을 실제 값으로 변경
# 3. .env 파일은 .gitignore에 포함되어 있어 Git에 커밋되지 않습니다
#
# ============================================

# ============================================
# 필수 설정 (배포 필수)
# ============================================

# Django SECRET_KEY
# 생성 방법: python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ⚠️ 보안: 이 키는 절대 공개하거나 Git에 커밋하지 마세요!
SECRET_KEY=your-secret-key-here

# 디버그 모드
# 로컬 개발: True
# 프로덕션 배포: False
DEBUG=True

# 허용된 호스트 (쉼표로 구분)
# 로컬 개발: localhost,127.0.0.1
# Railway 배포: your-app-name.railway.app,*.railway.app
# 커스텀 도메인: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# 데이터베이스 설정
# ============================================

# DATABASE_URL (Railway 배포 시 자동 설정됨)
# 로컬 개발: 비워두면 SQLite 사용 (db.sqlite3)
# 프로덕션: Railway에서 자동으로 PostgreSQL URL 설정
# PostgreSQL 직접 설정 예시:
# DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=

# ============================================
# 선택 설정 (향후 확장용)
# ============================================

# 사이트 URL (결과 공유 등에 사용)
# 로컬 개발: http://localhost:8000
# 프로덕션: https://your-app-name.railway.app
SITE_URL=http://localhost:8000

# 이메일 설정 (향후 이메일 전송 기능 구현 시 사용)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=your-email@gmail.com

# Stripe 결제 설정 (향후 구독 모델 구현 시 사용)
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
